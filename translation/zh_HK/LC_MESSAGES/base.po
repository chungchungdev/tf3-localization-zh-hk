#, fuzzy
msgid "MISSION_04_CUTSCENE_STEADYSEWAGE_1"
msgstr "還好世界衛生組織沒來參訪。"

#, fuzzy
msgid "MISSION_04_CUTSCENE_STEADYSEWAGE_2"
