msgid "VEHICLE_TRUCK_RIVIAN_EDV_DESCRIPTION"
msgstr ""
"Designed to be the next generation of small volume delivery in urban areas, "
"the Rivian Electric Delivery Van is famously used by a global online "
"retailer."

msgid "VEHICLE_TRUCK_RIVIAN_EDV_NAME"
msgstr "Rivian EDV Box"

msgid "VEHICLE_TRUCK_SAURER_C_TYP_BOX_DESCRIPTION"
msgstr ""
"The C-type engine was a revolutionary design by Adolph Saurer AG in "
"Switzerland that was used as the basis for many types of trucks and busses."

msgid "VEHICLE_TRUCK_SAURER_C_TYP_BOX_NAME"
msgstr "Saurer C Type Box"

msgid "VEHICLE_TRUCK_SAURER_C_TYP_TANK_DESCRIPTION"
msgstr ""
"The C-type engine was a revolutionary design by Adolph Saurer AG in "
"Switzerland that was used as the basis for many types of trucks and busses."

msgid "VEHICLE_TRUCK_SAURER_C_TYP_TANK_NAME"
msgstr "Saurer C Type Tank"

msgid "VEHICLE_TRUCK_SAURER_C_TYP_UNIV_DESCRIPTION"
