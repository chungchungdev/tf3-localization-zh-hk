msgstr "Freightliner FLD 112 Stake"

msgid "VEHICLE_TRUCK_GAZ_3307_BOX_DESCRIPTION"
msgstr ""
"Powered by a V8 gasoline engine, this Soviet-era truck not only served as a "
"versatile cargo hauler but was also frequently used as  a fire truck."

msgid "VEHICLE_TRUCK_GAZ_3307_BOX_NAME"
msgstr "GAZ 3307 Box"

msgid "VEHICLE_TRUCK_GAZ_3307_BULK_DESCRIPTION"
