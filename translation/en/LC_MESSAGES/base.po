msgstr "MAN 19.304"

msgid "VEHICLE_TRUCK_PETERBILT_359_BOX_DESCRIPTION"
msgstr ""
"The Peterbilt is an iconic long-haul semi-truck and a part of American truck "
"culture. Often equipped with chrome features it is also a statement of stlye."

msgid "VEHICLE_TRUCK_PETERBILT_359_BOX_NAME"
msgstr "Peterbilt 359 Box"

msgid "VEHICLE_TRUCK_PETERBILT_359_BULK_DESCRIPTION"
msgstr ""
"The Peterbilt is an iconic long-haul semi-truck and a part of American truck "
"culture. Often equipped with chrome features it is also a statement of stlye."

msgid "VEHICLE_TRUCK_PETERBILT_359_BULK_NAME"
