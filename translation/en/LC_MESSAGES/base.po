msgid "VEHICLE_TRUCK_FORD_77_BULK_DESCRIPTION"
msgstr ""
"With its distinctive barrel-nose front, this truck became ubiquitous "
"worldwide. It was designed as a standardized platform that could be "
"specialized for specific cargo."

msgid "VEHICLE_TRUCK_FORD_77_BULK_NAME"
msgstr "Ford Model 77 Bulk"

msgid "VEHICLE_TRUCK_FORD_AA_BOX_DESCRIPTION"
msgstr ""
"The Ford Model AA Delivery truck was an early 20th-century workhorse that "
"was widely used for commercial deliveries due to its reliability and "
"affordability."

msgid "VEHICLE_TRUCK_FORD_AA_BOX_NAME"
msgstr "Ford Model AA Box"

msgid "VEHICLE_TRUCK_FREIGHTLINER_FLD_112_BOX_DESCRIPTION"
msgstr ""
"The Freightliner is a classic American truck known for its aerodynamic "
"design, widely used for both regional and cross-country freight transport."

msgid "VEHICLE_TRUCK_FREIGHTLINER_FLD_112_BOX_NAME"
msgstr "Freightliner FLD 112 Box"

msgid "VEHICLE_TRUCK_FREIGHTLINER_FLD_112_STAKE_DESCRIPTION"
