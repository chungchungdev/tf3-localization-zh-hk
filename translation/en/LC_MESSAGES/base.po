msgid "VEHICLE_TRAM_TATRA_T4_BULK_NAME"
msgstr "Tatra T4 Bulk"

msgid "VEHICLE_TRAM_TATRA_T4_DESCRIPTION"
msgstr ""
"Built in Czechoslovakia by Tatra, it was a high-floor tram designed to "
"operate on narrow streets, making it popular in Eastern European cities."

msgid "VEHICLE_TRAM_TATRA_T4_NAME"
msgstr "Tatra T4"

msgid "VEHICLE_TRAM_TATRA_T4_STAKE_DESCRIPTION"
msgstr ""
"Some Eastern European cities converted passenger trams to service vehicles "
"to transport cargo and other materials within their own network."

msgid "VEHICLE_TRAM_TATRA_T4_STAKE_NAME"
