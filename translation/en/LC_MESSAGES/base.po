msgid "VEHICLE_WAGGON_EGOROV_20_2_NAME"
msgstr "Egorov 20 2"

msgid "VEHICLE_WAGGON_EW_II_DESCRIPTION"
msgstr ""
"Several novelties like double glazed windows and larger seating space were "
"introduced by the second generation of Swiss \"Einheitswagen\"."

msgid "VEHICLE_WAGGON_EW_II_NAME"
msgstr "Swiss Einheitswagen II"

msgid "VEHICLE_WAGGON_EW_IV_DESCRIPTION"
msgstr ""
"It was based on experience with the \"Einheitswagen II\" and even got a "
"higher maximum speed of 200 km/h after modifications."

msgid "VEHICLE_WAGGON_EW_IV_NAME"
msgstr "Swiss Einheitswagen IV"

