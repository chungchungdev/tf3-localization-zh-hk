msgid "VEHICLE_TRUCK_BENZ1912_BULK_NAME"
msgstr "Benz 3-Ton Bulk"

msgid "VEHICLE_TRUCK_FAW_JIEFANG_J6P_BOX_DESCRIPTION"
msgstr ""
"Developed in China over a period of seven years, this heavy truck was "
"designed with versatility in mind, resulting in more than 500 different "
"models."

msgid "VEHICLE_TRUCK_FAW_JIEFANG_J6P_BOX_NAME"
msgstr "FAW Jiefang J6P Box"

