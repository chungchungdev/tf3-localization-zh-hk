msgid "VEHICLE_TRUCK_MACK_AC_STAKE_NAME"
msgstr "Mack AC Stake"

msgid "VEHICLE_TRUCK_MAN_19_304_BOX_DESCRIPTION"
msgstr ""
"This six-wheeled German truck, powered by a robust V8 engine, was the first "
"to feature a forward-folding hood, making maintenance much easier."

msgid "VEHICLE_TRUCK_MAN_19_304_BOX_NAME"
msgstr "MAN 19.304 Box"

msgid "VEHICLE_TRUCK_MAN_19_304_BULK_DESCRIPTION"
