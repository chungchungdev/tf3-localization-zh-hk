msgid "VEHICLE_TRUCK_GAZ_MM_STAKE_NAME"
msgstr "GAZ MM Stake"

msgid "VEHICLE_TRUCK_GMC_660_DFM_BOX_DESCRIPTION"
msgstr ""
"Constructed by the General Motors Company in the forties, this truck proved "
"to be a a versatile medium-duty truck useful for both urban and agricultural "
