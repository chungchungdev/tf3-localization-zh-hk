msgid "VEHICLE_TRAM_UNIV_CAR_C_NAME"
msgstr "Cargo Car 2005"

msgid "VEHICLE_TRAM_VITYAZ_M_DESCRIPTION"
msgstr ""
"In this low-floor streetcar, the traction motors are housed in the bogies "
"under the floor, allowing for wider interior passageways."

msgid "VEHICLE_TRAM_VITYAZ_M_NAME"
msgstr "Moscow Vityaz M"

msgid "VEHICLE_TRUCK_AMO_F15_TANK_DESCRIPTION"
msgstr ""
"This Soviet truck was originally based on the Italian Fiat F-15, but "
"featured a Soviet-designed engine adapted to withstand the harsh northern "
"climate."

msgid "VEHICLE_TRUCK_AMO_F15_TANK_NAME"
msgstr "AMO F-15 Tank"

msgid "VEHICLE_TRUCK_AMO_F15_UNIV_DESCRIPTION"
msgstr ""
"This Soviet truck was originally based on the Italian Fiat F-15, but "
"featured a Soviet-designed engine adapted to withstand the harsh northern "
"climate."

msgid "VEHICLE_TRUCK_AMO_F15_UNIV_NAME"
msgstr "AMO F-15"

msgid "VEHICLE_TRUCK_BENZ1912_BOX_DESCRIPTION"
msgstr ""
"As one of the earliest motorized transport vehicles, this truck was powered "
"by a four-cylinder engine, with power transmitted to the rear axle via a "
"chain drive."

msgid "VEHICLE_TRUCK_BENZ1912_BOX_NAME"
msgstr "Benz 3-Ton Box"

msgid "VEHICLE_TRUCK_BENZ1912_BULK_DESCRIPTION"
