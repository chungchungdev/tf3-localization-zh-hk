msgstr "Isuzu Elf TLD20"

msgid "VEHICLE_TRUCK_KENWORTH_K100E_BOX_DESCRIPTION"
msgstr ""
"This american semi is also widely used in Australia and New Zealand. Its "
"double stack exhausts and the cab-over-engine setup inspired the design of "
"Optimus Prime."

msgid "VEHICLE_TRUCK_KENWORTH_K100E_BOX_NAME"
msgstr "Kenworth K100E Box"

msgid "VEHICLE_TRUCK_KENWORTH_K100E_BULK_DESCRIPTION"
