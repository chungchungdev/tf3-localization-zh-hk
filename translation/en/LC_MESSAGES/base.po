"to transport cargo and other materials within their own network."

msgid "VEHICLE_TRAM_TATRA_T4_BOX_NAME"
msgstr "Tatra T4 Box"

msgid "VEHICLE_TRAM_TATRA_T4_BULK_DESCRIPTION"
